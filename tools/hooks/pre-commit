#!/usr/bin/env bash
#
# SAF Pre-Commit Hook - Master Orchestrator
#
# Runs all configured validation hooks before allowing a commit.
# Hooks are executed in order defined in .githooks/config.yaml
#
# To bypass all hooks for emergency commits:
#   SKIP_HOOKS=1 git commit -m "emergency fix"
#
# Exit codes:
#   0 - All hooks passed
#   1 - One or more hooks failed
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

REPO_ROOT="$(git rev-parse --show-toplevel)"
HOOKS_DIR="${REPO_ROOT}/tools/hooks"
CONFIG_FILE="${REPO_ROOT}/.githooks/config.yaml"
LOG_DIR="${REPO_ROOT}/LogBook/audit"
LOG_FILE="${LOG_DIR}/hook-failures.log"

# Ensure log directory exists
mkdir -p "${LOG_DIR}"

# Check for global skip
if [ "${SKIP_HOOKS}" = "1" ]; then
    echo -e "${YELLOW}⚠ SKIP_HOOKS=1 - Bypassing all pre-commit hooks${NC}"
    echo "$(date -Iseconds) | BYPASS | ALL | User bypassed all hooks with SKIP_HOOKS=1" >> "${LOG_FILE}"
    exit 0
fi

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}SAF Pre-Commit Validation${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "${STAGED_FILES}" ]; then
    echo -e "${GREEN}✓ No staged files to validate${NC}"
    exit 0
fi

# Track results
FAILED_HOOKS=()
WARNED_HOOKS=()
PASSED_HOOKS=()
START_TIME=$(date +%s%N)

# Hook definitions with their scripts and skip vars
declare -A HOOKS
HOOKS["validate_yaml_schemas"]="validate_yaml_schemas.sh:SKIP_HOOK_YAML:blocking"
HOOKS["validate_state"]="validate_state.sh:SKIP_HOOK_STATE:blocking"
HOOKS["enforce_pm_boundaries"]="enforce_pm_boundaries.sh:SKIP_HOOK_PM_BOUNDARY:blocking"
HOOKS["validate_naming_conventions"]="validate_naming_conventions.sh:SKIP_HOOK_NAMING:warning"
HOOKS["check_circular_deps"]="check_circular_deps.sh:SKIP_HOOK_DEPS:blocking"
HOOKS["validate_policy_versions"]="validate_policy_versions.sh:SKIP_HOOK_POLICY:warning"
HOOKS["generate_logbook_entries"]="generate_logbook_entries.sh:SKIP_HOOK_LOGBOOK:info"

# Execution order (matches .githooks/config.yaml execution_order)
HOOK_ORDER=(
    "validate_yaml_schemas"
    "validate_state"
    "enforce_pm_boundaries"
    "validate_naming_conventions"
    "check_circular_deps"
    "validate_policy_versions"
    "generate_logbook_entries"
)

# Run each hook
for hook_name in "${HOOK_ORDER[@]}"; do
    IFS=':' read -r script skip_var severity <<< "${HOOKS[$hook_name]}"
    hook_script="${HOOKS_DIR}/${script}"

    # Check if hook exists
    if [ ! -x "${hook_script}" ]; then
        echo -e "  ${YELLOW}⊘${NC} ${hook_name}: Script not found (skipped)"
        continue
    fi

    # Check for individual skip
    if [ "${!skip_var}" = "1" ]; then
        echo -e "  ${YELLOW}⊘${NC} ${hook_name}: Skipped (${skip_var}=1)"
        echo "$(date -Iseconds) | SKIP | ${hook_name} | User skipped with ${skip_var}=1" >> "${LOG_FILE}"
        continue
    fi

    # Run hook
    echo -ne "  ◦ ${hook_name}..."

    set +e
    output=$("${hook_script}" 2>&1)
    exit_code=$?
    set -e

    if [ ${exit_code} -eq 0 ]; then
        echo -e "\r  ${GREEN}✓${NC} ${hook_name}"
        PASSED_HOOKS+=("${hook_name}")
    elif [ "${severity}" = "warning" ]; then
        echo -e "\r  ${YELLOW}⚠${NC} ${hook_name} (warning)"
        if [ -n "${output}" ]; then
            echo "${output}" | sed 's/^/      /'
        fi
        WARNED_HOOKS+=("${hook_name}")
    else
        echo -e "\r  ${RED}✗${NC} ${hook_name} (FAILED)"
        if [ -n "${output}" ]; then
            echo "${output}" | sed 's/^/      /'
        fi
        FAILED_HOOKS+=("${hook_name}")
        echo "$(date -Iseconds) | FAIL | ${hook_name} | ${output}" >> "${LOG_FILE}"
    fi
done

# Calculate duration
END_TIME=$(date +%s%N)
DURATION_MS=$(( (END_TIME - START_TIME) / 1000000 ))

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Summary
echo -e "Results: ${GREEN}${#PASSED_HOOKS[@]} passed${NC}, ${YELLOW}${#WARNED_HOOKS[@]} warnings${NC}, ${RED}${#FAILED_HOOKS[@]} failed${NC}"
echo -e "Duration: ${DURATION_MS}ms"

# Check if any blocking hooks failed
if [ ${#FAILED_HOOKS[@]} -gt 0 ]; then
    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}COMMIT BLOCKED${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Failed hooks: ${FAILED_HOOKS[*]}"
    echo ""
    echo "To fix: Address the issues reported above"
    echo "To bypass (emergency): SKIP_HOOKS=1 git commit -m \"...\""
    echo ""
    exit 1
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}All checks passed - commit allowed${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

exit 0
